# =====================================================================
#  AgriN configuration
# =====================================================================

# ---- Google AI (required) -------------------------------------------
# Path A — AI Studio. Free tier, no GCP project needed.
#   Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Path B — Vertex AI. For production deployment with IAM, VPC-SC,
# audit logging and regional data residency. Uses Application Default
# Credentials (`gcloud auth application-default login`).
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# Model selection
AGRIN_MODEL=gemini-3.7-flash
AGRIN_VISION_MODEL=gemini-3.7-flash

# More than one AI Studio key, comma separated, tried in order.
#
# The free tier meters per project, so a key on a second Google account is a
# second full allowance -- another twenty requests per day on every model in
# the chain. Ten models across two keys is four hundred requests a day, and
# it costs nothing. Get one at https://aistudio.google.com/apikey.
#
# Keys are tried model-major: the best model on every key before dropping to
# a weaker one, because answering a farmer well matters more than which
# allowance pays for it.
#
# GEMINI_API_KEY above still works on its own; this is only for adding more.
# GEMINI_API_KEYS=key-one,key-two

# Fallback models, tried in order when the one above is unavailable.
#
# On the free tier this list is also the daily budget. The quota that bites
# is GenerateRequestsPerDayPerProjectPerModel: twenty requests per day PER
# MODEL, not per minute. One model is therefore twenty questions a day for
# everything -- chat, speech, photo diagnosis -- and the chain is what makes
# the service usable at all. Ten models is two hundred requests a day.
#
# Do not add gemini-2.5-flash or gemini-2.5-flash-lite. They are listed by
# the models endpoint but return 404 "no longer available to new users" on a
# recently issued key, so every one is a dead entry that fails on every walk.
# A probe run (scripts/prewarm.py) is what surfaces this.
#
# Ordered strongest first: a lite model answers a farmer's question less well
# but answers it, which beats an error. gemini-flash-latest anchors the end
# because it always resolves to a current model, so the chain cannot rot as
# named versions retire.
#
# A second API key on a different Google account doubles this again, and is
# the cheapest fix if the allowance runs short during a demo.
AGRIN_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-latest

# ---- Google Cloud services ------------------------------------------
# Speech-to-Text / Text-to-Speech / Translation. Enabled per-API in GCP.
# The browser Web Speech API is used as a no-key fallback in development.
GOOGLE_MAPS_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Google Earth Engine (satellite NDVI). Requires a registered EE project.
#   Register: https://code.earthengine.google.com/register
EARTHENGINE_PROJECT=

# ---- Indian public data ---------------------------------------------
# data.gov.in — Agmarknet mandi prices, soil health card.
#   Free key: https://data.gov.in/apis then LOGIN | REGISTER
#   (authentication is via JanParichay national single sign-on; the older
#    /user/register path returns 404 since the portal was rebuilt)
#   Without this the shared demo key is used, which is heavily rate limited.
DATA_GOV_IN_KEY=

# ---- No key required -------------------------------------------------
# ISRIC SoilGrids, Open-Meteo (forecast + ERA5), NASA POWER

# ---- Infra ------------------------------------------------------------
AGRIN_DB=
AGRIN_CACHE_DIR=
AGRIN_CORS_ORIGINS=http://localhost:5173
