# ---- LLM providers (orchestrator) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Optional OpenAI-compatible fallback provider.
# Set BASE_URL to the provider's endpoint before this is used.
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=

# ---- Data sources ----
# No key required: Open-Meteo, ISRIC SoilGrids, MS Planetary Computer, NASA POWER
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
DATA_GOV_IN_KEY=

# ---- Infra ----
DATABASE_URL=postgresql://agrin:agrin@localhost:5433/agrin
REDIS_URL=redis://localhost:6380/0
